#!/bin/sh
# Before pushing: the vX.Y.Z tag matches the version in apps/desktop/package.json, typecheck and tests pass.
# A push of change/* branches only skips the typecheck and tests: spec-dispatch pushes them after the
# orchestrator ran the suite, and CI runs the same suite on their pull request.
zero=0000000000000000000000000000000000000000
checks=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  case "$local_ref" in
    refs/tags/v*)
      tag=${local_ref#refs/tags/}
      ver=$(git show "$local_sha:apps/desktop/package.json" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>console.log(JSON.parse(s).version))')
      if [ "v$ver" != "$tag" ]; then
        echo "Tag $tag does not match version $ver in apps/desktop/package.json. Tags are created only by npm run release." >&2
        exit 1
      fi ;;
  esac
  case "$remote_ref" in
    refs/heads/change/*) ;;
    *) checks=1 ;;
  esac
done
[ "$checks" = 1 ] || exit 0
# git sets GIT_DIR and friends for hooks; a test that runs git in its own temporary repository would
# otherwise write to this repository (on 2026-10-23 a test set core.bare=true and committed here).
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_PREFIX
npm run typecheck < /dev/null && npm test -- --maxWorkers=4 < /dev/null
