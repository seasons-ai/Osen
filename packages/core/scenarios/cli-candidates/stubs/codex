#!/bin/sh
# Stand stub of the codex CLI: never calls a model. Settings come from stub.env next to this file.
. "$(dirname "$0")/stub.env"
case "$1 $2" in
  "--version ") echo x >> "$COUNTER.version"; echo "codex-cli $VERSION" ;;
  "exec --help") echo x >> "$COUNTER.help"; cat "$HELP_FILE" ;;
  "features list") echo x >> "$COUNTER.features"; cat "$FEATURES_FILE" ;;
  *) echo x >> "$COUNTER.turn"; exit 1 ;;
esac
