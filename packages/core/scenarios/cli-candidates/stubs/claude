#!/bin/sh
# Stand stub of the claude CLI: never calls a model. Settings come from stub.env next to this file.
. "$(dirname "$0")/stub.env"
case "$1" in
  --version) echo x >> "$COUNTER.version"; echo "$VERSION (Claude Code)" ;;
  --help) echo x >> "$COUNTER.help"; cat "$HELP_FILE" ;;
  *) echo x >> "$COUNTER.turn"; exit 1 ;;
esac
